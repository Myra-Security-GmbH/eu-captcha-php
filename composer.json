{
    "name": "myra-security-gmbh/eu-captcha",
    "description": "EU captcha protects your website/API against abuse like form spam and credential stuffing",
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^6.0 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Myrasec\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Myrasec\\Tests\\": "tests/"
        }
    }
}
